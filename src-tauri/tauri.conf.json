{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GPT-POWERSHELL.loop",
  "version": "0.1.0",
  "identifier": "dev.gptpowershell.loop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GPT-POWERSHELL.loop",
        "width": 900,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
